# Nyx runtime artifacts — Layer A databases are derived/local, never committed.
# The schema (schema.sql) is committed; instantiated databases are not.
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Local intake / corpus (founding purpose is document ingestion; the corpus is
# machine-local data, not source). Keep the directory structure, ignore contents.
inbox/
corpus/
keystore/

